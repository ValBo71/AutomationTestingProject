{
  "name": "restful-booker-platform-api-typescript",
  "version": "1.0.0",
  "description": "Playwright + TypeScript API and hybrid API/UI automation for the restful-booker-platform (automationintesting.online)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=hybrid",
    "test:headed": "playwright test --project=hybrid --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "api-testing",
    "contract-testing",
    "restful-booker-platform"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "zod": "^3.23.8"
  }
}
